{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CC Agent Flows",
  "version": "0.9.5",
  "identifier": "com.alinflorin.ccagentflows",
  "build": {
    "beforeDevCommand": "pnpm qemu:fetch && pnpm images:fetch && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm qemu:fetch --required && pnpm images:fetch --required && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CC Agent Flows",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 520,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/qemu/": "qemu/",
      "resources/images/": "images/",
      "resources/agentd/": "agentd/"
    },
    "publisher": "Alin-Florin Ciu",
    "shortDescription": "CC Agent Flows desktop app"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc1NjhDMDMxQzFEQkYzNTkKUldSWjg5dkJNY0JvZGM5aDJQTCtmYmRXTHNJSk1ySlRYMHVSQUJjR0laYkZLUVcyWTJSMGVZT1QK",
      "endpoints": [
        "https://github.com/alinflorin/cc-agent-flows/releases/latest/download/latest.json"
      ]
    }
  }
}
